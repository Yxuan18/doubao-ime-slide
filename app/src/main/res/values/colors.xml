<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 图标底色：深墨。不用渐变，缩到 48dp 时渐变会糊成一团。 -->
    <color name="ic_launcher_background">#14181F</color>

    <!-- 唯一的强调色，只用在开关轨道上。暖赭石，与图标的冷墨底形成对比；
         不用蓝色/紫色——那是默认模板最容易撞的颜色。

         亮色下取深一档的 #A9691F：轨道上的白拨杆是"开"的唯一信号，
         与 #C8873C 的对比度只有 3.0:1（非文本组件及格线），卡在线上；
         #A9691F 是 4.4:1。暗色走 values-night/colors.xml 里的亮一档，
         因为那边要分开的是轨道与深底，不是拨杆与轨道。 -->
    <color name="accent">#A9691F</color>
</resources>
